#!/usr/bin/env bash
# secretsmith launcher — Bun runtime (converted from python 2026-10-26).
# Symlink ~/.local/bin/secretsmith -> this file. Resolves through symlinks so
# the script is found whether invoked directly or via the symlink.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi
exec bun "$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/secretsmith.ts" "$@"
